#!/usr/bin/env bash
# commit-msg hook: reject commits whose message fails commitlint.
# Enable with `make hooks` (git config core.hooksPath .githooks).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if command -v bunx >/dev/null 2>&1; then
  exec bunx --silent commitlint --edit "$1"
elif command -v npx >/dev/null 2>&1; then
  exec npx --yes commitlint --edit "$1"
else
  echo "commitlint skipped: install bun or node" >&2
  exit 0
fi
