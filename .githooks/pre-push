#!/usr/bin/env bash
# pre-push hook: fast local CI (format, clippy, tests, last commit message)
# before anything reaches the remote. Enable with `make hooks`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: cargo fmt --check"
cargo fmt --all -- --check
echo "pre-push: cargo clippy"
cargo clippy --all-targets -- -D warnings
echo "pre-push: cargo test"
cargo test --all-targets
echo "pre-push: commitlint"
if command -v bunx >/dev/null 2>&1; then
  git log --pretty=%B origin/main..HEAD 2>/dev/null | bunx --silent commitlint || \
    git log -1 --pretty=%B | bunx --silent commitlint --last
fi
